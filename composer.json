{
  "name": "dimipress/rally",
  "description": "A WordPress table-tennis competition engine.",
  "type": "wordpress-plugin",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "DimiPress\\Rally\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DimiPress\\Rally\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration phpstan.neon.dist --debug",
    "lint": "phpcs --standard=phpcs.xml.dist src tests",
    "check": [
      "@test",
      "@analyse",
      "@lint"
    ]
  }
}
